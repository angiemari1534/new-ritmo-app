# Copy this file to ".env" and paste your real keys after the = sign.
# NEVER share the .env file or commit it anywhere public.

# --- MiniMax (generates the sung song) ---
MINIMAX_API_KEY=paste_your_minimax_key_here
# Optional: override the music model (default: music-3.0)
# MINIMAX_MODEL=music-3.0

# --- ElevenLabs (generates the spoken pronunciation clip) ---
ELEVENLABS_API_KEY=paste_your_elevenlabs_key_here
# Optional: pick a specific voice / model
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Port the server runs on locally (Render sets this automatically in the cloud)
PORT=3000
